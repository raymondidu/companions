COMPANION_OANDA_BASE_URL=https://api-fxpractice.oanda.com
COMPANION_OANDA_TOKEN=
COMPANION_OANDA_ACCOUNT_ID=
COMPANION_SILVER_PROVIDER_SYMBOL=XAG_USD
COMPANION_USOIL_PROVIDER_SYMBOL=WTICO_USD
COMPANION_BTC_PROVIDER_SYMBOL=BTC-USD
COMPANION_COINBASE_BASE_URL=https://api.exchange.coinbase.com
COMPANION_BINANCE_BASE_URL=https://api.binance.com
COMPANION_DATA_DIR=/app/companion-data
COMPANION_SCAN_INTERVAL_SECONDS=60
COMPANION_EXNESS_ACCOUNT_SYMBOLS=

# TradeHouse executor transport. Use the same executor base URL/secret as Gold.
COMPANION_EXECUTOR_BASE_URL=
COMPANION_EXECUTOR_SECRET=
# Optional separate callback HMAC secret. If blank, COMPANION_EXECUTOR_SECRET is used.
COMPANION_CALLBACK_HMAC_SECRET=
# Informational analyzer-side switch only. Real opens remain controlled by TradeHouse's pilot switch.
COMPANION_TRADEHOUSE_PILOT_ENABLED=false
